PROJECT_NAME="JobFit Resume Agent"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
DATABASE_URL="sqlite:///./jobfit.db"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"
LLM_MODE=mock
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://mx.free.codesonline.dev
OPENAI_MODEL=gpt-5.4
OPENAI_REVIEW_MODEL=gpt-5.4
OPENAI_WIRE_API=responses
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0
MODEL_REASONING_EFFORT=xhigh
JD_REASONING_EFFORT=medium
PROFILE_REASONING_EFFORT=medium
RESUME_REASONING_EFFORT=xhigh
REVIEW_REASONING_EFFORT=xhigh
JD_ANALYSIS_CHUNK_SIZE=260
DISABLE_RESPONSE_STORAGE=true
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0

# DeepSeek official API example:
# LLM_PROVIDER=deepseek
# OPENAI_API_KEY=your_deepseek_key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-pro
# OPENAI_REVIEW_MODEL=deepseek-v4-pro
# OPENAI_WIRE_API=chat_completions
